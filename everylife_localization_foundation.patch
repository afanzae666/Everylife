diff -ruN everylife_original/Everylife-main/test/data/storage/android_ui_settings_language_test.dart everylife_work/Everylife-main/test/data/storage/android_ui_settings_language_test.dart
--- everylife_original/Everylife-main/test/data/storage/android_ui_settings_language_test.dart	1970-01-01 00:00:00.000000000 +0000
+++ everylife_work/Everylife-main/test/data/storage/android_ui_settings_language_test.dart	2026-11-13 17:18:53.895537732 +0000
@@ -0,0 +1,47 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+
+import '../../../lib/data/storage/android_ui_settings_storage.dart';
+
+void main() {
+  group('AndroidUiSettingsStorage language preference', () {
+    late Directory directory;
+    late AndroidUiSettingsStorage storage;
+
+    setUp(() async {
+      directory = await Directory.systemTemp.createTemp(
+        'everylife-language-settings-',
+      );
+      storage = AndroidUiSettingsStorage(
+        directoryProvider: () async => directory,
+      );
+    });
+
+    tearDown(() async {
+      if (await directory.exists()) {
+        await directory.delete(recursive: true);
+      }
+    });
+
+    test('persists language code in the shared UI settings file', () async {
+      await storage.writeUiScale(1.1);
+      await storage.writeThemeMode('dark');
+      await storage.writeLanguageCode('id');
+
+      expect(await storage.readLanguageCode(), 'id');
+      expect(await storage.readUiScale(), 1.1);
+      expect(await storage.readThemeMode(), 'dark');
+
+      final settingsFile = File(
+        '${directory.path}/everylife_ui_settings.json',
+      );
+      final contents = await settingsFile.readAsString();
+      expect(contents, contains('"languageCode":"id"'));
+    });
+
+    test('returns null when no language preference has been saved', () async {
+      expect(await storage.readLanguageCode(), isNull);
+    });
+  });
+}
